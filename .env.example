# GEMINI_API_KEY: Unused by the game itself (legacy AI Studio template placeholder).
# GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (optional, backend use).
# APP_URL=""

# VITE_BASE_PATH: Optional public base path override (defaults to "./" for GitHub Pages compatibility).
# VITE_BASE_PATH="/chronicles-of-the-forgotten-realms/"

# VITE_ONLINE_SERVER_URL: Optional URL of a separate Node.js server.ts host for online multiplayer when UI is on GitHub Pages.
# VITE_ONLINE_SERVER_URL="https://your-free-node-host.onrender.com"
